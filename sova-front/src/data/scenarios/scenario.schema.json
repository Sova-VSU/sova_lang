{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.app/schemas/scenario.json",
  "title": "Sova Scenario",
  "description": "Структура интерактивного сценария для ScenarioPlayer. Файлы: src/data/scenarios/{id}.json",
  "type": "object",
  "required": ["id", "title", "emoji", "startStepId", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Уникальный идентификатор сценария (slug). Совпадает с :id в маршруте /scenarios/:id",
      "examples": ["coffee", "restaurant", "airport", "hotel"]
    },
    "title": {
      "type": "string",
      "description": "Заголовок сценария в шапке плеера (обычно на английском, капсом)",
      "examples": ["COFFEE SHOP", "HOTEL CHECK-IN"]
    },
    "emoji": {
      "type": "string",
      "description": "Эмодзи сценария",
      "examples": ["☕", "🏨"]
    },
    "startStepId": {
      "type": "string",
      "description": "ID первого шага из объекта steps",
      "examples": ["step-1"]
    },
    "completionMessage": {
      "type": "string",
      "description": "Сообщение на экране результатов после завершения"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Версия контента (опционально, для API и кэша)"
    },
    "theme": {
      "$ref": "#/$defs/Theme"
    },
    "steps": {
      "type": "object",
      "description": "Граф шагов: ключ — ID шага, значение — описание шага",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Step"
      }
    }
  },
  "$defs": {
    "Theme": {
      "type": "object",
      "description": "Визуальная тема сценария (CSS-переменные в ScenarioPlayer)",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "description": "Фон страницы (CSS background)"
        },
        "cardBackground": {
          "type": "string",
          "description": "Фон карточки сценария"
        },
        "accentColor": {
          "type": "string",
          "description": "Акцентный цвет заголовка и рамки"
        },
        "primaryButton": {
          "type": "string",
          "description": "Цвет кнопки «Далее»"
        },
        "npcBubbleColor": {
          "type": "string",
          "description": "Фон реплики NPC"
        },
        "decorations": {
          "type": "array",
          "description": "Декоративные эмодзи на фоне",
          "items": { "type": "string" }
        }
      }
    },
    "Npc": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "description": "Реплика персонажа (на английском)"
        },
        "avatar": {
          "type": "string",
          "description": "Эмодзи-аватар NPC",
          "default": "🧑‍🍳"
        }
      }
    },
    "ChoiceOption": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "ID выбора; используется в nextByChoice и configByChoice"
        },
        "emoji": {
          "type": "string",
          "description": "Эмодзи на карточке выбора"
        },
        "label": {
          "type": "string",
          "description": "Подпись на карточке выбора"
        }
      }
    },
    "Choices": {
      "type": "object",
      "required": ["label", "options"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Заголовок блока выбора (на русском)"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ChoiceOption" }
        }
      }
    },
    "Step": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Название шага (в топбаре и истории)"
        },
        "emoji": {
          "type": "string",
          "description": "Эмодзи шага (если нет — берётся emoji сценария)"
        },
        "requireChoice": {
          "type": "boolean",
          "description": "true — задание показывается только после выбора варианта",
          "default": false
        },
        "isFinal": {
          "type": "boolean",
          "description": "true — последний шаг; показывается кнопка «Завершить сценарий»",
          "default": false
        },
        "npc": {
          "$ref": "#/$defs/Npc"
        },
        "choices": {
          "$ref": "#/$defs/Choices"
        },
        "tasks": {
          "type": "array",
          "description": "Задания на шаге (по порядку; после каждого — «Далее» к следующему заданию)",
          "items": { "$ref": "#/$defs/Task" }
        },
        "next": {
          "type": ["string", "null"],
          "description": "ID следующего шага (если переход не зависит от выбора). null — конец ветки"
        },
        "nextByChoice": {
          "type": "object",
          "description": "Переход по выбору: ключ — choice.id, значение — ID шага",
          "propertyNames": { "type": "string" },
          "additionalProperties": {
            "type": ["string", "null"]
          }
        }
      },
      "anyOf": [
        { "required": ["next"] },
        { "required": ["nextByChoice"] },
        { "required": ["isFinal"] }
      ]
    },
    "Task": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "fill-blank",
            "word-order",
            "multiple-choice",
            "translation",
            "matching",
            "phrase-builder"
          ],
          "description": "Тип задания (компонент из TaskRegistry)"
        },
        "config": {
          "description": "Конфиг задания (если одинаков для всех вариантов выбора)"
        },
        "configByChoice": {
          "type": "object",
          "description": "Конфиг задания по choice.id; ключи должны совпадать с choices.options[].id на этом шаге",
          "propertyNames": { "type": "string" },
          "additionalProperties": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "fill-blank" },
            "config": { "$ref": "#/$defs/FillBlankConfig" },
            "configByChoice": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/FillBlankConfig" }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "word-order" },
            "config": { "$ref": "#/$defs/WordOrderConfig" },
            "configByChoice": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/WordOrderConfig" }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "multiple-choice" },
            "config": { "$ref": "#/$defs/MultipleChoiceConfig" },
            "configByChoice": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/MultipleChoiceConfig" }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "translation" },
            "config": { "$ref": "#/$defs/TranslationConfig" },
            "configByChoice": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/TranslationConfig" }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "matching" },
            "config": { "$ref": "#/$defs/MatchingConfig" },
            "configByChoice": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/MatchingConfig" }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "phrase-builder" },
            "config": { "$ref": "#/$defs/PhraseBuilderConfig" },
            "configByChoice": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/PhraseBuilderConfig" }
            }
          }
        }
      ],
      "anyOf": [
        { "required": ["config"] },
        { "required": ["configByChoice"] }
      ]
    },
    "FillBlankConfig": {
      "type": "object",
      "required": ["sentence", "options", "correctAnswer"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Заголовок задания (по умолчанию: «Заполните пропуск:»)"
        },
        "sentence": {
          "type": "string",
          "description": "Предложение с пропуском; ___ — место для ответа",
          "examples": ["I'd like a ___ , please."]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Варианты для вставки в пропуск"
        },
        "correctAnswer": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "Несколько допустимых ответов"
            }
          ]
        },
        "tip": {
          "type": "string",
          "description": "Подсказка при правильном ответе"
        }
      }
    },
    "WordOrderConfig": {
      "type": "object",
      "required": ["correctOrder"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "hint": {
          "type": "string",
          "description": "Подсказка над полем (целевая фраза)"
        },
        "correctOrder": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Правильный порядок слов (слова перемешиваются при показе)"
        },
        "tip": { "type": "string" }
      }
    },
    "MultipleChoiceConfig": {
      "type": "object",
      "required": ["options", "correctIndex"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "question": {
          "type": "string",
          "description": "Текст вопроса"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" },
          "description": "Варианты ответа (индекс с 0)"
        },
        "correctIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Индекс правильного варианта в options"
        },
        "tip": { "type": "string" }
      }
    },
    "TranslationConfig": {
      "type": "object",
      "required": ["sourceText", "options", "correctIndex"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "sourceText": {
          "type": "string",
          "description": "Исходная фраза на русском"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" },
          "description": "Варианты перевода на английский"
        },
        "correctIndex": {
          "type": "integer",
          "minimum": 0
        },
        "tip": { "type": "string" }
      }
    },
    "MatchingConfig": {
      "type": "object",
      "required": ["pairs"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Заголовок (по умолчанию: «Соедините пары:»)"
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["en", "ru"],
            "additionalProperties": false,
            "properties": {
              "en": { "type": "string", "description": "Слово/фраза на английском" },
              "ru": { "type": "string", "description": "Перевод на русском" }
            }
          }
        }
      }
    },
    "PhraseBuilderConfig": {
      "type": "object",
      "required": ["availableWords"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "availableWords": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Слова для составления фразы"
        },
        "requiredWord": {
          "type": "string",
          "description": "Обязательное слово (должно совпасть с выбором на шаге)"
        },
        "politeWords": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Слова, делающие фразу вежливой"
        },
        "politeMessage": { "type": "string" },
        "rudeMessage": { "type": "string" },
        "politeTip": { "type": "string" },
        "rudeTip": { "type": "string" }
      }
    },
    "ScenarioCatalogItem": {
      "type": "object",
      "description": "Элемент списка на странице /scenarios (отдельно от полного сценария)",
      "required": ["id", "title", "description", "emoji", "locked"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "description": "Название на русском" },
        "description": { "type": "string" },
        "emoji": { "type": "string" },
        "locked": {
          "type": "boolean",
          "description": "true — сценарий недоступен"
        },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "ScenarioCatalog": {
      "type": "object",
      "required": ["scenarios"],
      "additionalProperties": false,
      "properties": {
        "scenarios": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScenarioCatalogItem" }
        }
      }
    }
  }
}
